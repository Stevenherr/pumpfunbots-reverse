RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
HELIUS_API_KEY=YOUR_HELIUS_API_KEY

# Sniper config
SNIPER_BUY_SOL=0.1
SNIPER_TAKE_PROFIT=2.0
SNIPER_STOP_LOSS=0.5
SNIPER_TIMEOUT_SEC=120
SNIPER_MAX_POSITIONS=3
SNIPER_MIN_DEV_BUY=0.5
SNIPER_COOLDOWN_SEC=10

# Copy trader config
COPY_TARGETS=wallet1,wallet2
COPY_BUY_SOL=0.05
COPY_SELL_PCT=100
COPY_MAX_POSITIONS=5

# Analytics
ANALYTICS_PORT=3000
