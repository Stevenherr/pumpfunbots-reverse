RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
HELIUS_API_KEY=YOUR_HELIUS_API_KEY

# Sniper config
SNIPER_BUY_SOL=0.1
SNIPER_TAKE_PROFIT=2.0
# 0.94 = Stop bei -6% vom Fill-Preis (nicht vom Kurvenpreis vor dem Kauf)
SNIPER_STOP_LOSS=0.94
SNIPER_TIMEOUT_SEC=120
SNIPER_MAX_POSITIONS=3
SNIPER_MIN_DEV_BUY=0.5
SNIPER_COOLDOWN_SEC=10
# Kein zweiter Kauf desselben Mints nach einem Stop. Pause nach jedem Exit.
SNIPER_NO_REENTRY_AFTER_STOP=1
SNIPER_TOKEN_COOLDOWN_SEC=600
# Nur eine frische Curve. 30-45 SOL real sind kein Launch mehr.
SNIPER_MAX_CURVE_SOL=12

# Copy trader config
COPY_TARGETS=wallet1,wallet2
COPY_BUY_SOL=0.05
COPY_SELL_PCT=100
COPY_MAX_POSITIONS=5
COPY_STOP_LOSS=0.94

# Graduation sniper
GRAD_BUY_SOL=0.1
GRAD_MIN_FILL_PCT=92
GRAD_TAKE_PROFIT=1.5
GRAD_STOP_LOSS=0.94
GRAD_TIMEOUT_SEC=300
GRAD_MAX_POSITIONS=3
GRAD_COOLDOWN_SEC=30
# Pro Token, auch nach einem abgelehnten Versuch. Verhindert denselben Mint im Sekundentakt.
GRAD_TOKEN_COOLDOWN_SEC=600
# 1: nach einem Stop-Loss wird derselbe Mint nicht wieder gekauft (data/graduation-block.json).
GRAD_NO_REENTRY_AFTER_STOP=1
# Der erste Print über der Fill-Schwelle kauft nicht. So viele Sekunden muss der Kurs halten.
GRAD_CONFIRM_SEC=8
# Größerer Rücksetzer in dem Fenster überspringt den Einstieg. 0 schaltet nur die Dip-Prüfung ab.
GRAD_CONFIRM_MAX_DIP=0.02
# Der Stop bleibt 0.94 vom Fill. Der Verkauf kann danach noch durch Slippage tiefer fillen
# (im Dry-Run etwa −6.4% bis −9.5% statt genau −6%).

# Rug-Check, läuft vor jedem Kauf von Sniper, Copy-Trader und Graduation-Sniper.
# Ablehnung wird mit Grund geloggt. 1 = an, 0 = aus.
RUG_REJECT_MINT_AUTHORITY=1
RUG_REJECT_FREEZE_AUTHORITY=1
# Größter Holder außer der Bonding Curve, in Prozent der Supply.
RUG_MAX_TOP_HOLDER_PCT=20
# Anteil der Supply aus dem Dev-Buy des Creators.
RUG_MAX_DEV_BUY_SHARE_PCT=10
# Launches dieses Creators, die der Bot gesehen und in data/creator-history.json gemerkt hat.
RUG_MAX_CREATOR_LAUNCHES=3
# Frühere Stop-Loss-Rugs desselben Creators. 0 = schon ein früherer Rug lehnt ab.
RUG_MAX_CREATOR_RUGS=0
# Rohzahl der letzten Signaturen ist standardmäßig AUS (0).
# Eine volle RPC-Seite (oft genau 100) ist die Obergrenze der Abfrage, keine echte Anzahl,
# und wird nie als Treffer gewertet. Nur setzen, wenn eine unvollständige Seite
# über diesem Limit ablehnen soll.
RUG_MAX_CREATOR_SIGNATURES=0
# Reale SOL in der Bonding Curve. Darunter gilt die Liquidität als zu dünn.
RUG_MIN_REAL_SOL=0.4
# 1: echte Datenlücken lehnen den Kauf ab. Ein HTTP 429 ist davon getrennt:
# der Kauf wird verschoben, nicht als Rug gezählt, und ohne Daten nie ausgeführt.
RUG_FAIL_CLOSED=1

# Gemeinsames RPC-Budget aller Bots auf einem Free-Tier (Datei data/rpc-budget.json).
# Web3-interne 429-Retries sind aus; der Limiter wartet 500ms, 1s, 2s, höchstens 4s.
RPC_MAX_PER_SEC=5
# Cache für Konto-Lesen. Halter-Listen cachen 30s. Kein Cache auf Send/Balance.
RPC_CACHE_MS=3000
# Eine gehaltene Position pro Tick, plus ein eigenes Log-Abo je Mint.
# 8s ohne Mint-Abo hat Stops bis 0.71x des Fills durchrutschen lassen.
POSITION_POLL_MS=1000
# Verkauf früher auslösen, damit der Fill näher an -6% landet. 0.03 bei Stop 0.94 => Trigger 0.97.
# 0 schaltet die Marge ab. Der ausgewiesene Stop bleibt 0.94.
STOP_EARLY_MARGIN=0.03

# Freigabe vor echtem Kauf. Standard ist aus: der Bot signiert nicht allein.
# AUTO_BUY=1 oder --auto schaltet die manuelle Freigabe ab.
AUTO_BUY=0
# Sekunden, danach verfällt ein nicht entschiedener Vorschlag.
APPROVAL_TTL_SEC=180
# Optionaler Pfad. Standard: data/approvals.json
# APPROVAL_FILE=

# Analytics
ANALYTICS_PORT=3000
